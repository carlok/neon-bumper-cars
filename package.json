{
  "name": "neon-survival-bumper-cars",
  "version": "1.1.24",
  "description": "Multiplayer WebSocket bumper cars game with mobile controllers",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node scripts/assert-podman-tests.js && jest --testPathPatterns=test/",
    "test:coverage": "node scripts/assert-podman-tests.js && jest --testPathPatterns=test/ --coverage"
  },
  "jest": {
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov"
    ],
    "collectCoverageFrom": [
      "src/**/*.js"
    ]
  },
  "dependencies": {
    "express": "^4.22.3",
    "socket.io": "^4.7.4"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "nodemon": "^3.1.14"
  },
  "overrides": {
    "chokidar": "^4.0.3",
    "js-yaml": "^4.3.2"
  }
}
